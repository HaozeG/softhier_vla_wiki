#!/usr/bin/env bash
# Enforces the wiki's git-as-log convention. Enable with: tools/wiki.py install-hooks
subject=$(head -n1 "$1")
case "$subject" in Merge*|Revert*|fixup!*|squash!*) exit 0 ;; esac
if ! [[ "$subject" =~ ^wiki\((ingest|update|delete|lint|refactor|init)\):\ .+ ]]; then
  echo "commit-msg: subject must be 'wiki(<ingest|update|delete|lint|refactor|init>): <subject>' (use tools/wiki.py commit)" >&2
  exit 1
fi
if ! grep -qE '^Date: [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$1"; then
  echo "commit-msg: missing 'Date: YYYY-MM-DD' trailer (use tools/wiki.py commit)" >&2
  exit 1
fi
